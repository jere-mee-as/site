<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme: the WebView draws everything. No window animation, no wallpaper behind. -->
    <style name="Theme.JRL" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/field</item>
        <item name="android:windowBackground">@color/field</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
